<style>
  table { border-collapse: collapse; margin-bottom: 2em; }
  th, td { border: 1px solid #ccc; padding: 6px 12px; }
  th { background: #f2f2f2; text-align: left; }
  td.number { text-align: right; }
</style>

<h1>KelloggCoin Ledger</h1>

<!-- Step 1: List all transactions, starting with the ICO -->
<h2>Transactions</h2>
<table>
  <thead>
    <tr>
      <th>Transaction #</th>
      <th>Amount (KC)</th>
      <th>Sender</th>
      <th>Receiver</th>
    </tr>
  </thead>
  <tbody>
    <% Transaction.order(:id).each_with_index do |transaction, index| %>
      <% from_user = User.find_by(id: transaction.from_user_id) %>
      <% to_user = User.find_by(id: transaction.to_user_id) %>
      <tr>
        <td class="number"><%= index + 1 %></td>
        <td class="number"><%= transaction.amount %></td>
        <td>
          <% if from_user %>
            <%= from_user.name %>
          <% else %>
            Initial coin offering
          <% end %>
        </td>
        <td><%= to_user&.name %></td>
      </tr>
    <% end %>
  </tbody>
</table>

<!-- Step 2: Calculate and display the balances -->
<h2>Final Balances</h2>
<table>
  <thead>
    <tr>
      <th>User</th>
      <th>Balance (KC)</th>
    </tr>
  </thead>
  <tbody>
    <% User.order(:id).each do |user| %>
      <% received = Transaction.where({ "to_user_id" => user.id }).sum("amount") %>
      <% sent = Transaction.where({ "from_user_id" => user.id }).sum("amount") %>
      <tr>
        <td><%= user.name %></td>
        <td class="number"><%= received - sent %></td>
      </tr>
    <% end %>
  </tbody>
</table>

